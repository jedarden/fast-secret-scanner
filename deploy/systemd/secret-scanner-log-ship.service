[Unit]
Description=Ship secret-scanner events to the fleet VictoriaLogs (iad-ci)
Wants=network-online.target
After=network-online.target

# Reads ~/.local/state/secret-scanner/events.jsonl past its cursor and POSTs
# complete lines to VictoriaLogs /insert/jsonline. Events stay in the local
# file until a POST succeeds, so a failed run loses nothing; the next run
# retries. Override the destination with SECRET_SCANNER_LOG_URL (or "off").
[Service]
Type=oneshot
ExecStart=/usr/bin/env python3 %h/.local/share/secret-scanner/scanlog.py ship
TimeoutStartSec=2min
NoNewPrivileges=true
