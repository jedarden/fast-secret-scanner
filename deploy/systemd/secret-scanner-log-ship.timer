[Unit]
Description=Ship secret-scanner events every 2 minutes

# OnCalendar, not a monotonic trigger: monotonic-only user timers stop firing
# after a systemd --user restart.
[Timer]
OnCalendar=*:0/2
RandomizedDelaySec=30
Persistent=true
Unit=secret-scanner-log-ship.service

[Install]
WantedBy=timers.target
