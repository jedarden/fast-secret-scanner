[Unit]
Description=Reconcile Forgejo secret-scan hooks for owned repositories
Wants=network-online.target
After=network-online.target

# rollout.sh replaces every fleet hook whose content differs from its own copy,
# so that copy must be origin/main, never the shared checkout's working tree:
# a lagging or locally edited checkout would reinstall its version across the
# fleet every 15 minutes (fss-3b6010db). A failed fetch fails the run.
[Service]
Type=oneshot
RuntimeDirectory=secret-scanner-reconcile
WorkingDirectory=%h/declarative-config
ExecStartPre=/usr/bin/env git -C %h/declarative-config fetch -q origin main
ExecStart=/usr/bin/env bash -c 'set -euo pipefail; d="$${RUNTIME_DIRECTORY:?}"; rm -rf -- "$$d/tools"; git -C "$$HOME/declarative-config" archive origin/main tools/forgejo-secret-scan | tar -x -C "$$d"; exec "$$d/tools/forgejo-secret-scan/rollout.sh" --apply'
TimeoutStartSec=20min
NoNewPrivileges=true
