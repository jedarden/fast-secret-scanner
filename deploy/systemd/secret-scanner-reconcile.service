[Unit]
Description=Reconcile Forgejo secret-scan hooks for owned repositories
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/declarative-config
ExecStart=%h/declarative-config/tools/forgejo-secret-scan/rollout.sh --apply
TimeoutStartSec=20min
NoNewPrivileges=true
