#!/usr/bin/env bash
# Shared Git hook dispatcher: fast Rust scan, preserved repository hooks,
# then the existing fleet Gitleaks dispatcher.
set -u

hook="$(basename "$0")"
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
rust="${SECRET_SCANNER_BIN:-$HOME/.local/bin/secret-scanner}"

if [ "$hook" = pre-commit ]; then
  # Event log (hooks/scanlog.py): records blocks and failures with the
  # scanner's stderr, which this hook otherwise never shows. Logging can
  # never change the commit decision.
  event_log="$HOME/.local/share/secret-scanner/scanlog.py"
  started_ms="$(date +%s%3N 2>/dev/null || echo 0)"
  log_event() { # outcome message [findings-file]
    [ -f "$event_log" ] || return 0
    command -v python3 >/dev/null 2>&1 || return 0
    python3 "$event_log" record --component git-pre-commit --outcome "$1" \
      --message "$2" --field "repo=$root" --field "scanner_rc=${result:-127}" \
      --field "duration_ms=$(( $(date +%s%3N 2>/dev/null || echo 0) - started_ms ))" \
      --stderr-file "${errors:-/dev/null}" ${3:+--findings-file "$3"} \
      >/dev/null 2>&1 || true
  }
  details=''
  [ -f "$event_log" ] && details=' (details: secret-scanner-events tail)'

  if [ ! -x "$rust" ]; then
    log_event error "scanner binary missing or not executable: $rust"
    echo "secret-scanner: runtime unavailable; commit blocked$details" >&2
    exit 1
  fi
  report="$(mktemp)" || exit 1
  errors="$(mktemp)" || { rm -f -- "$report"; exit 1; }
  trap 'rm -f -- "$report" "$errors"' EXIT
  (cd "$root" && "$rust" --staged) >"$report" 2>"$errors"
  result=$?
  case "$result" in
    0) ;;
    1)
      log_event blocked "staged changes hold a possible secret" "$report"
      echo 'secret-scanner: possible secret in staged changes:' >&2
      sed -n '1,20p' "$report" >&2
      echo 'secret-scanner: remove the candidate, rotate it if live, then restage' >&2
      # Bead checkpoints are content-addressed; a hand edit breaks the store.
      if grep -q '^\(.*/\)\{0,1\}\.beads/' "$report"; then
        echo 'secret-scanner: never edit .beads/ by hand; remove bead store findings with `bead doctor --scope secrets` and `bead redact --all-blocking --actor <you> --reason <why>`' >&2
      fi
      exit 1
      ;;
    3)
      echo 'secret-scanner: binary input skipped; continuing to the comprehensive Git hook' >&2
      ;;
    *)
      log_event error "scanner exited $result on staged changes"
      echo "secret-scanner: execution failed (exit $result); commit blocked$details" >&2
      exit 1
      ;;
  esac
fi

# Local overrides saved by install-git-hooks.py. These are worktree-relative
# when Git stored a relative core.hooksPath. Preserve the original hook first.
previous="$(git config --local --get secretScanner.previousHooksPath 2>/dev/null || true)"
if [ -n "$previous" ]; then
  case "$previous" in
    /*) previous_hook="$previous/$hook" ;;
    *) previous_hook="$root/$previous/$hook" ;;
  esac
  if [ -x "$previous_hook" ] && [ "$(readlink -f "$previous_hook")" != "$(readlink -f "$0")" ]; then
    "$previous_hook" "$@" || exit $?
  fi
fi

delegate="$(git config --global --get secretScanner.delegateHooksPath 2>/dev/null || true)"
if [ -n "$delegate" ] && [ -x "$delegate/$hook" ]; then
  exec "$delegate/$hook" "$@"
fi
exit 0
